{
  "version": 8,
  "name": "RADR",
  "metadata": {
    "radr:note": "Pitched camera, DEM hillshade, extruded buildings. Web also raises the terrain mesh. See SOURCES.md."
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "© OpenStreetMap contributors, © OpenMapTiles, OpenFreeMap"
    },
    "radr-dem": {
      "type": "raster-dem",
      "tiles": ["https://tiles.mapterhorn.com/{z}/{x}/{y}.webp"],
      "tileSize": 512,
      "encoding": "terrarium",
      "maxzoom": 12,
      "attribution": "Terrain © Mapterhorn"
    },
    "radr-satellite": {
      "type": "raster",
      "tiles": ["https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2021_3857/default/g/{z}/{y}/{x}.jpg"],
      "tileSize": 256,
      "maxzoom": 14,
      "attribution": "Imagery © EOX (Copernicus Sentinel data)"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "light": {
    "anchor": "viewport",
    "color": "#ffffff",
    "intensity": 0.45,
    "position": [1.4, 210, 40]
  },
  "terrain": {
    "source": "radr-dem",
    "exaggeration": 1.15
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {"background-color": "#141b27"}
    },
    {
      "id": "radr-satellite",
      "type": "raster",
      "source": "radr-satellite",
      "layout": {"visibility": "none"},
      "paint": {"raster-opacity": 1, "raster-fade-duration": 0}
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {"fill-color": "#16324a"}
    },
    {
      "id": "landuse-green",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["match", ["get", "class"], ["park", "grass", "wood", "forest", "cemetery"], true, false],
      "paint": {"fill-color": "#1c3a34", "fill-opacity": 0.85}
    },
    {
      "id": "landuse-built",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["match", ["get", "class"], ["residential", "commercial", "industrial", "retail"], true, false],
      "paint": {"fill-color": "#1e2736", "fill-opacity": 0.7}
    },
    {
      "id": "radr-hillshade",
      "type": "hillshade",
      "source": "radr-dem",
      "paint": {
        "hillshade-exaggeration": 0.35,
        "hillshade-shadow-color": "#070b12",
        "hillshade-highlight-color": "#f3f0e8",
        "hillshade-accent-color": "#6a7c74",
        "hillshade-illumination-direction": 220
      }
    },
    {
      "id": "radr-rail",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["rail", "transit"], true, false],
      "paint": {
        "line-color": "#7f93b0",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.4, 14, 1.4],
        "line-opacity": 0.45,
        "line-dasharray": [2, 2]
      }
    },
    {
      "id": "radr-roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 5,
      "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service", "track"], true, false],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": [
          "match", ["get", "class"],
          "motorway", "#e4c36a",
          "trunk", "#d7c49a",
          "primary", "#e4e7ee",
          "secondary", "#c9d0da",
          "#8f98a6"
        ],
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.3, 10, 1.1, 14, 2.4, 16, 5, 18, 10]
      }
    },
    {
      "id": "radr-buildings-flat",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 14,
      "layout": {"visibility": "none"},
      "paint": {"fill-color": "#3a4458", "fill-opacity": 0.85}
    },
    {
      "id": "radr-buildings-3d",
      "type": "fill-extrusion",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 15,
      "paint": {
        "fill-extrusion-color": "#8b95a8",
        "fill-extrusion-height": ["coalesce", ["get", "render_height"], ["get", "height"], 8],
        "fill-extrusion-base": ["coalesce", ["get", "render_min_height"], ["get", "min_height"], 0],
        "fill-extrusion-opacity": 0.92
      }
    },
    {
      "id": "place-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 4,
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 4, 10, 10, 14],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#e7edf4",
        "text-halo-color": "#121820",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "road-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 13,
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 11,
        "symbol-placement": "line",
        "text-max-angle": 30
      },
      "paint": {
        "text-color": "#d5dbe3",
        "text-halo-color": "#121820",
        "text-halo-width": 1
      }
    }
  ]
}
